# Copiá este archivo como .env.local (en local) o .env (en el VPS) y completá los valores.

# URL que se muestra en el código QR para que la gente vote.
# - En desarrollo local:   http://localhost:3000/vote
# - En tu red local (wifi): http://192.168.X.X:3000/vote
# - En el VPS sin dominio:  http://TU_IP_PUBLICA:3000/vote
# - En el VPS con dominio:  https://tudominio.com/vote
#
# IMPORTANTE: esta variable empieza con NEXT_PUBLIC_, así que se incrusta
# en el momento del build. Si la cambiás, hay que volver a correr `npm run build`.
NEXT_PUBLIC_VOTE_URL=http://localhost:3000/vote

# Puerto donde corre el servidor (por defecto 3000).
PORT=3000
